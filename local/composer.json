{
    "name": "codematrix-studio/bitrix-quickstart",
    "description": "Minimal project structure and Composer autoloading for 1C-Bitrix projects",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Project\\": "php_interface/classes/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test:compatibility": "php ../tests/lema_compatibility_smoke.php",
        "test:forms": "php ../tests/lema_forms_smoke.php",
        "test": [
            "@test:compatibility",
            "@test:forms",
            "@test:iblock",
            "@test:helper"
        ],
        "test:iblock": "php ../tests/lema_iblock_smoke.php",
        "test:helper": "php ../tests/lema_helper_smoke.php"
    }
}
