{
    "name": "codematrix-studio/bitrix-quickstart",
    "description": "Minimal project structure and Composer autoloading for 1C-Bitrix projects",
    "type": "project",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Project\\": "php_interface/classes/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test:compatibility": "php ../tests/lema_compatibility_smoke.php",
        "test:forms": "php ../tests/lema_forms_smoke.php",
        "test:video-url-parser": "php ../tests/video_url_parser_smoke.php",
        "test": [
            "@test:compatibility",
            "@test:forms",
            "@test:video-url-parser",
            "@test:iblock",
            "@test:iblock-validator",
            "@test:helper",
            "@test:base",
            "@test:markup",
            "@test:export",
            "@test:template",
            "@test:page",
            "@test:context",
            "@test:asset",
            "@test:file-icons",
            "@test:hlblock",
            "@test:d7-basket",
            "@test:d7-order",
            "@test:d7-quick-order",
            "@test:d7-quick-order-input",
            "@test:product-list",
            "@test:seo-analytics",
            "@test:d7-basket-handler",
            "@test:yes-no-property",
            "@test:color-property",
            "@test:youtube-property"
        ],
        "test:iblock": [
            "php ../tests/lema_iblock_smoke.php",
            "php ../tests/lema_iblock_checker_smoke.php"
        ],
        "test:helper": "php ../tests/lema_helper_smoke.php",
        "test:base": "php ../tests/lema_base_instances_smoke.php",
        "test:markup": "php ../tests/lema_markup_smoke.php",
        "test:export": "php ../tests/lema_export_smoke.php",
        "test:iblock-validator": "php ../tests/iblock_validator_compatibility_smoke.php",
        "test:template": "php ../tests/template_helper_smoke.php",
        "test:page": "php ../tests/page_path_matcher_smoke.php",
        "test:asset": "php ../tests/asset_manager_smoke.php",
        "test:file-icons": "php ../tests/file_type_icon_resolver_smoke.php",
        "test:hlblock": "php ../tests/hlblock_smoke.php",
        "test:d7-basket": "php ../tests/d7_basket_manager_smoke.php",
        "test:d7-order": "php ../tests/d7_order_manager_smoke.php",
        "test:d7-quick-order": "php ../tests/d7_quick_order_smoke.php",
        "test:d7-quick-order-input": "php ../tests/d7_quick_order_input_smoke.php",
        "test:product-list": "php ../tests/product_id_list_smoke.php",
        "test:context": "php ../tests/bitrix_context_smoke.php",
        "test:seo-analytics": "php ../tests/seo_analytics_smoke.php",
        "test:d7-basket-handler": "php ../tests/d7_basket_handler_smoke.php",
        "test:yes-no-property": "php ../tests/iblock_yes_no_property_smoke.php",
        "test:color-property": "php ../tests/iblock_color_property_smoke.php",
        "test:youtube-property": "php ../tests/iblock_youtube_property_smoke.php"
    }
}
