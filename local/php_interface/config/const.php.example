<?php

/**
 * Пример конфигурации проекта.
 *
 * Скопируйте файл в const.php и укажите значения конкретного сайта.
 * Файл const.php исключён из Git и не должен содержать пароли, токены
 * или другие секреты.
 */

defined('PROJECT_NAME') || define('PROJECT_NAME', 'MyProject');
defined('PROJECT_ENV') || define('PROJECT_ENV', 'production');

/**
 * Управление файловым логированием.
 * true — включить запись в /local/logs/; false — выключить.
 */
defined('PROJECT_LOG_ENABLED') || define('PROJECT_LOG_ENABLED', false);

/**
 * Пути проекта (от корня сайта).
 *
 * Перенесены и адаптированы из ASDAFF/bitrix.quickstart.
 * Проверьте наличие соответствующих каталогов и файлов в конкретном проекте.
 */
defined('SITE_PATH_LOGO') || define('SITE_PATH_LOGO', '/local/assets/images/logo');
defined('PATH_CSS') || define('PATH_CSS', '/local/assets/css');
defined('PATH_JS') || define('PATH_JS', '/local/assets/js');
defined('PATH_GLOBAL_CSS') || define('PATH_GLOBAL_CSS', PATH_CSS . '/global.css');
defined('PATH_GLOBAL_JS') || define('PATH_GLOBAL_JS', PATH_JS . '/global.js');
defined('PATH_RESPONSIVE_CSS') || define('PATH_RESPONSIVE_CSS', PATH_CSS . '/responsive.css');
defined('PATH_AJAX') || define('PATH_AJAX', '/local/ajax/');
defined('PATH_AJAX_JS') || define('PATH_AJAX_JS', PATH_AJAX . 'ajax.js');
defined('PATH_BOWER_COMPONENTS') || define('PATH_BOWER_COMPONENTS', '/local/assets/bower_components');
defined('PATH_LIBRARY') || define('PATH_LIBRARY', '/local/assets/lib');
defined('PATH_INCLUDE') || define('PATH_INCLUDE', '/include/');
defined('PATH_BACKEND_JS') || define('PATH_BACKEND_JS', '/local/assets/backend/js');
defined('PATH_BACKEND_CSS') || define('PATH_BACKEND_CSS', '/local/assets/backend/css');

/**
 * Идентификаторы инфоблоков.
 *
 * Заполняются отдельно для каждого сайта. Не используйте ID из другого проекта.
 */
// defined('IBLOCK_ID__CATALOG') || define('IBLOCK_ID__CATALOG', 0);
// defined('IBLOCK_ID__OFFERS') || define('IBLOCK_ID__OFFERS', 0);
// defined('IBLOCK_ID__VIDEO') || define('IBLOCK_ID__VIDEO', 0);

