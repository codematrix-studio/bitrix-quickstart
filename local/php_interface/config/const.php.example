<?php

/**
 * Пример локальной конфигурации проекта.
 *
 * При необходимости скопируйте файл в const.php и измените значения
 * под конкретный сайт. Сам const.php исключён из Git.
 *
 * Не размещайте здесь пароли, токены, ключи API и другие секреты.
 */

// Основные параметры проекта.
defined('PROJECT_NAME') || define('PROJECT_NAME', 'MyProject');
defined('PROJECT_ENV') || define('PROJECT_ENV', 'production');

/**
 * Файловое логирование.
 *
 * true  — включить запись в /local/logs/;
 * false — выключить.
 *
 * Каталог local/logs входит в каркас проекта. Убедитесь, что у PHP
 * есть необходимые права на запись.
 */
defined('PROJECT_LOG_ENABLED') || define('PROJECT_LOG_ENABLED', false);

/**
 * Необязательные пути к ресурсам сайта.
